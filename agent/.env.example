# Copy to .env. Provider credentials stay in this server process.
GLM_API_KEY=
# For another compatible provider, use AGENT_API_KEY (takes precedence).
AGENT_API_KEY=
AGENT_PROVIDER_ID=glm
AGENT_MODEL=glm-5.3-flash
AGENT_PROVIDER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Initial application budgets; verify against the selected account's model limit.
AGENT_CONTEXT_WINDOW=128000
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_MAX_MODEL_TURNS=128
AGENT_HOST=127.0.0.1
AGENT_PORT=4317
AGENT_TOKEN=
# HTTP mode: only this verified business email may manage instance provider settings.
# Requests and canvas sessions always use the host user's PB identity.
AGENT_OWNER_ID=your-business-email
AGENT_CANVAS_ID=your-existing-canvas-id
AGENT_DATA_DIR=./data
AGENT_CANVAS_MODE=http
AGENT_SKILL_ROOTS=
# HTTP mode verifies each host user's PB token through the bridge identity endpoint.
DANGOO_BRIDGE_URL=http://127.0.0.1:7000/api/agent-bridge/v1/
# Hosted VibeX uses X-Pb-Auth; direct PocketBase uses Authorization.
DANGOO_AUTH_HEADER=Authorization
# Set AGENT_AIGC_INTERNAL_URL on the PocketBase process, not this Agent process:
# AGENT_AIGC_INTERNAL_URL=http://127.0.0.1:7000
